# DB-TRACE Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# Neo4j (local Docker or AuraDB Free)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dbtrace_dev_password

# PostgreSQL (App DB - Neon in production, SQLite fallback locally)
DATABASE_URL=sqlite:///./data/dbtrace.db

# Target PostgreSQL DB to scan for grants (optional local or Neon branch)
TARGET_PG_URL=postgresql://dbtrace_scanner:scanner_pass@localhost:5433/target_app

# MLflow
MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db

# Optional LLM Narrator (Ollama local or OpenAI-compatible)
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
